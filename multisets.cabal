cabal-version:  3.0
name:           multisets
version:        0.0.0.0
bug-reports:    https://github.com/jonathanknowles/multisets/issues
license:        Apache-2.0
license-file:   LICENSE
author:         Jonathan Knowles
maintainer:     mail@jonathanknowles.net
copyright:      2023 Jonathan Knowles
category:
synopsis:
description:

extra-doc-files:
    README.md

common dependency-base
    build-depends:base                          >= 4.14.3.0   && < 4.21
common dependency-commutative-semigroups
    build-depends:commutative-semigroups        >= 0.2        && < 0.3
common dependency-containers
    build-depends:containers                    >= 0.6.5.1    && < 0.8
common dependency-deepseq
    build-depends:deepseq                       >= 1.4.4.0    && < 1.6
common dependency-groups
    build-depends:groups                        >= 0.5.3      && < 0.6
common dependency-hspec
    build-depends:hspec                         >= 2.10.9     && < 2.12
common dependency-monoid-subclasses
    build-depends:monoid-subclasses             >= 1.2.3      && < 1.3
common dependency-monoidmap
    build-depends:monoidmap                     >= 0.0.0.0    && < 0.1
common dependency-pretty-show
    build-depends:pretty-show                   >= 1.10       && < 1.11
common dependency-QuickCheck
    build-depends:QuickCheck                    >= 2.14.2     && < 2.15
common dependency-quickcheck-classes
    build-depends:quickcheck-classes            >= 0.6.5.0    && < 0.7
common dependency-quickcheck-groups
    build-depends:quickcheck-groups             >= 0.0.1.0    && < 0.1
common dependency-semirings
    build-depends:semirings                     >= 0.7        && < 0.8
common dependency-tasty-bench
    build-depends:tasty-bench                   >= 0.3.2      && < 0.5
common dependency-tasty-hunit
    build-depends:tasty-hunit                   >= 0.10.0.3   && < 0.11

common extensions
    default-extensions:
        ConstraintKinds
        DefaultSignatures
        DeriveFunctor
        DerivingStrategies
        DerivingVia
        FlexibleContexts
        FlexibleInstances
        GeneralizedNewtypeDeriving
        ImportQualifiedPost
        LambdaCase
        MultiParamTypeClasses
        NoImplicitPrelude
        ScopedTypeVariables
        StandaloneDeriving
        TupleSections
        TypeApplications
        TypeFamilies
        TypeOperators
        ViewPatterns

source-repository head
    type: git
    location: https://github.com/jonathanknowles/multisets

library
    import:
      , dependency-base
      , dependency-containers
      , dependency-groups
      , dependency-monoidmap
      , extensions
    hs-source-dirs:
        lib/public
    exposed-modules:
        Data.Bag
        Data.Bag.Signed
        Data.Set.Signed
        Data.Sign
        Data.Map.SeqMap
        Data.Map.SetMap
    default-language:
        Haskell2010
    build-depends:
        internal

library internal
    import:
      , dependency-base
      , dependency-commutative-semigroups
      , dependency-containers
      , dependency-deepseq
      , dependency-groups
      , dependency-monoid-subclasses
      , dependency-monoidmap
      , dependency-semirings
      , extensions
    hs-source-dirs:
        lib/internal
    exposed-modules:
        Internal.Data.Count
        Internal.Data.CountMap
        Internal.Data.Monoid
        Internal.Data.Packed
        Internal.Data.Sign
        Internal.Data.Sign.Model
        Internal.Data.Sign.NonZero
        Internal.Shared
    default-language:
        Haskell2010

test-suite test
    import:
      , dependency-base
      , dependency-hspec
      , dependency-pretty-show
      , dependency-QuickCheck
      , dependency-quickcheck-classes
      , dependency-quickcheck-groups
      , extensions
    ghc-options:
        -threaded -with-rtsopts=-N
    main-is:
        Spec.hs
    hs-source-dirs:
        exe/test
    other-modules:
        Data.SignSpec
        SpecHook
        Test.QuickCheck.Classes.Hspec
        Test.Hspec.Unit
    type:
        exitcode-stdio-1.0
    default-language:
        Haskell2010
    build-tool-depends:
        hspec-discover:hspec-discover ==2.*
    build-depends:
      , multisets
      , multisets:internal

benchmark benchmark
    import:
      , dependency-base
      , dependency-containers
      , dependency-deepseq
      , dependency-tasty-bench
      , dependency-tasty-hunit
      , extensions
    default-language:
        Haskell2010
    type:
        exitcode-stdio-1.0
    hs-source-dirs:
        exe/benchmark
    main-is:
        Main.hs
    build-depends:
      , multisets
